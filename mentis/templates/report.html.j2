<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mentis Report</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #0f1117;
            color: #e2e8f0;
            line-height: 1.6;
            padding: 2rem;
        }
        header {
            border-bottom: 2px solid #6366f1;
            padding-bottom: 1.5rem;
            margin-bottom: 2.5rem;
        }
        header h1 {
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #6366f1, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .generated-at { color: #94a3b8; font-size: 0.875rem; margin-top: 0.25rem; }

        section {
            background: #1e2130;
            border: 1px solid #2d3655;
            border-radius: 12px;
            padding: 1.75rem;
            margin-bottom: 2rem;
        }
        section h2 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #a78bfa;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .score-badge {
            display: inline-block;
            padding: 0.2rem 0.75rem;
            border-radius: 999px;
            font-size: 0.8rem;
            font-weight: 700;
            margin-left: 0.5rem;
        }
        .score-high   { background: #166534; color: #86efac; }
        .score-mid    { background: #713f12; color: #fde68a; }
        .score-low    { background: #7f1d1d; color: #fca5a5; }

        table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
        th {
            text-align: left;
            padding: 0.6rem 1rem;
            background: #2d3655;
            color: #94a3b8;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
        }
        td { padding: 0.6rem 1rem; border-bottom: 1px solid #2d3655; color: #cbd5e1; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #252b42; }

        .badge {
            display: inline-block;
            padding: 0.15rem 0.6rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }
        .badge-critical { background: #7f1d1d; color: #fca5a5; }
        .badge-warning  { background: #713f12; color: #fde68a; }
        .badge-info     { background: #1e3a5f; color: #93c5fd; }
        .badge-passed   { background: #166534; color: #86efac; }
        .badge-failed   { background: #7f1d1d; color: #fca5a5; }
        .badge-drift    { background: #7f1d1d; color: #fca5a5; }
        .badge-ok       { background: #166534; color: #86efac; }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            background: #2d3655;
            border-radius: 8px;
            padding: 1rem;
            text-align: center;
        }
        .stat-card .value { font-size: 1.6rem; font-weight: 800; color: #a78bfa; }
        .stat-card .label { font-size: 0.75rem; color: #94a3b8; margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em; }

        pre {
            background: #0f1117;
            border: 1px solid #2d3655;
            border-radius: 6px;
            padding: 1rem;
            font-size: 0.8rem;
            overflow-x: auto;
            color: #94a3b8;
            white-space: pre-wrap;
            word-break: break-all;
        }
        footer {
            text-align: center;
            color: #475569;
            font-size: 0.8rem;
            margin-top: 3rem;
            padding-top: 1.5rem;
            border-top: 1px solid #2d3655;
        }
        .empty-state { color: #475569; font-style: italic; text-align: center; padding: 1.5rem; }
        .degraded-alert {
            background: #451a03;
            border: 1px solid #92400e;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            color: #fde68a;
            margin-bottom: 1rem;
            font-weight: 600;
        }
        .healthy-alert {
            background: #052e16;
            border: 1px solid #166534;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            color: #86efac;
            margin-bottom: 1rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <h1>🧠 Mentis Report</h1>
        <p class="generated-at">Generated: {{ generated_at }}</p>
    </header>

    {# ── Dataset Scan ─────────────────────────────────────────── #}
    {% if scan %}
    <section>
        <h2>📊 Dataset Scan</h2>
        <div class="stat-grid">
            <div class="stat-card"><div class="value">{{ scan.n_rows | default('—') }}</div><div class="label">Rows</div></div>
            <div class="stat-card"><div class="value">{{ scan.n_columns | default('—') }}</div><div class="label">Columns</div></div>
            <div class="stat-card"><div class="value">{{ scan.summary.severity_counts.critical | default(0) }}</div><div class="label">Critical</div></div>
            <div class="stat-card"><div class="value">{{ scan.summary.severity_counts.warning | default(0) }}</div><div class="label">Warnings</div></div>
            <div class="stat-card"><div class="value">{{ "%.2f"|format(scan.memory_usage_mb | default(0)) }} MB</div><div class="label">Memory</div></div>
        </div>
        {% if scan.findings %}
        <table>
            <thead><tr><th>Check</th><th>Severity</th><th>Message</th><th>Suggestion</th></tr></thead>
            <tbody>
            {% for f in scan.findings %}
            <tr>
                <td>{{ f.check_name }}</td>
                <td><span class="badge badge-{{ f.severity }}">{{ f.severity }}</span></td>
                <td>{{ f.message }}</td>
                <td>{{ f.suggestion | default('—') }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">✅ No findings — dataset looks clean.</p>
        {% endif %}
    </section>
    {% endif %}

    {# ── Model Comparison ─────────────────────────────────────── #}
    {% if comparison %}
    <section>
        <h2>🏆 Model Comparison</h2>
        {% if comparison.results %}
        <table>
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Model</th>
                    {% for key in comparison.results[0].metrics.keys() %}<th>{{ key }}</th>{% endfor %}
                    <th>CV Mean</th>
                    <th>CV Std</th>
                    <th>Train Time (s)</th>
                </tr>
            </thead>
            <tbody>
            {% for r in comparison.results %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><strong>{{ r.model_name }}</strong></td>
                {% for v in r.metrics.values() %}<td>{{ "%.4f"|format(v) }}</td>{% endfor %}
                <td>{{ "%.4f"|format(r.cv_mean) }}</td>
                <td>± {{ "%.4f"|format(r.cv_std) }}</td>
                <td>{{ "%.3f"|format(r.training_time_seconds) }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No model results available.</p>
        {% endif %}
    </section>
    {% endif %}

    {# ── Explainability ───────────────────────────────────────── #}
    {% if explain %}
    <section>
        <h2>🔍 Explainability</h2>
        {% if explain.shap %}
        <p><strong>SHAP</strong> — Explainer type: <code>{{ explain.shap.explainer_type }}</code> · Base value: <code>{{ "%.4f"|format(explain.shap.base_value) }}</code></p>
        {% endif %}
        {% if explain.permutation_importance %}
        <br>
        <table>
            <thead><tr><th>Feature</th><th>Permutation Importance</th></tr></thead>
            <tbody>
            {% for feat, imp in explain.permutation_importance.items() | sort(attribute='1', reverse=True) %}
            <tr><td>{{ feat }}</td><td>{{ "%.6f"|format(imp) }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        {% if explain.confusion_matrix %}
        <br><p><strong>Confusion Matrix:</strong></p>
        <pre>{{ explain.confusion_matrix }}</pre>
        {% endif %}
    </section>
    {% endif %}

    {# ── Pipeline Audit ───────────────────────────────────────── #}
    {% if audit %}
    <section>
        {% set score = audit.score | float %}
        {% if score >= 70 %}{% set cls = "score-high" %}
        {% elif score >= 40 %}{% set cls = "score-mid" %}
        {% else %}{% set cls = "score-low" %}{% endif %}
        <h2>🔬 Pipeline Audit <span class="score-badge {{ cls }}">{{ score }}/100</span></h2>
        <table>
            <thead><tr><th>Check</th><th>Status</th><th>Severity</th><th>Suggestion</th></tr></thead>
            <tbody>
            {% for f in audit.findings %}
            <tr>
                <td>{{ f.name }}</td>
                <td><span class="badge {{ 'badge-passed' if f.passed else 'badge-failed' }}">{{ '✓ Passed' if f.passed else '✗ Failed' }}</span></td>
                <td>{% if not f.passed %}<span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>{% else %}—{% endif %}</td>
                <td>{% if not f.passed %}{{ f.suggestion }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
    {% endif %}

    {# ── Deployment Readiness ─────────────────────────────────── #}
    {% if deployment %}
    <section>
        {% set score = deployment.score | float %}
        {% if score >= 70 %}{% set cls = "score-high" %}
        {% elif score >= 40 %}{% set cls = "score-mid" %}
        {% else %}{% set cls = "score-low" %}{% endif %}
        <h2>🚀 Deployment Readiness <span class="score-badge {{ cls }}">{{ score }}/100</span></h2>
        {% if deployment.detected_framework %}
        <p style="margin-bottom:1rem;">Framework detected: <strong style="color:#a78bfa">{{ deployment.detected_framework }}</strong></p>
        {% endif %}
        <table>
            <thead><tr><th>Check</th><th>Status</th><th>Severity</th><th>Suggestion</th></tr></thead>
            <tbody>
            {% for f in deployment.findings %}
            <tr>
                <td>{{ f.name }}</td>
                <td><span class="badge {{ 'badge-passed' if f.passed else 'badge-failed' }}">{{ '✓ Passed' if f.passed else '✗ Failed' }}</span></td>
                <td>{% if not f.passed %}<span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>{% else %}—{% endif %}</td>
                <td>{% if not f.passed %}{{ f.suggestion }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
    {% endif %}

    {# ── Bias / Fairness ──────────────────────────────────────── #}
    {% if bias %}
    <section>
        <h2>⚖️ Bias / Fairness</h2>
        <table>
            <thead><tr><th>Sensitive Feature</th><th>Demo. Parity Diff</th><th>Equal Opp. Diff</th><th>Equalized Odds Diff</th></tr></thead>
            <tbody>
            {% for b in bias %}
            <tr>
                <td><strong>{{ b.sensitive_feature }}</strong></td>
                <td>{{ "%.4f"|format(b.demographic_parity_difference) }}</td>
                <td>{{ "%.4f"|format(b.equal_opportunity_difference) }}</td>
                <td>{{ "%.4f"|format(b.equalized_odds_difference) }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
    {% endif %}

    {# ── Data Drift ───────────────────────────────────────────── #}
    {% if drift %}
    <section>
        <h2>📉 Data Drift</h2>
        <div class="stat-grid">
            <div class="stat-card">
                <div class="value" style="color:{{ '#fca5a5' if drift.dataset_drift else '#86efac' }}">{{ 'YES' if drift.dataset_drift else 'NO' }}</div>
                <div class="label">Dataset Drift</div>
            </div>
            <div class="stat-card">
                <div class="value">{{ "%.1f"|format((drift.drift_share | default(0)) * 100) }}%</div>
                <div class="label">Drift Share</div>
            </div>
        </div>
        {% if drift.feature_drift %}
        <table>
            <thead><tr><th>Feature</th><th>Drift Detected</th><th>Drift Score</th><th>Stat Test</th></tr></thead>
            <tbody>
            {% for col, info in drift.feature_drift.items() %}
            <tr>
                <td>{{ col }}</td>
                <td><span class="badge {{ 'badge-drift' if info.drift_detected else 'badge-ok' }}">{{ 'Drift' if info.drift_detected else 'OK' }}</span></td>
                <td>{{ "%.4f"|format(info.drift_score) }}</td>
                <td>{{ info.stattest_name | default('—') }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </section>
    {% endif %}

    {# ── Monitoring ───────────────────────────────────────────── #}
    {% if monitoring %}
    <section>
        <h2>📡 Monitoring</h2>
        {% if monitoring.degraded %}
        <div class="degraded-alert">⚠️ Model degradation detected — one or more metrics dropped beyond tolerance.</div>
        {% else %}
        <div class="healthy-alert">✅ Model health looks stable — no degradation detected.</div>
        {% endif %}
        {% if monitoring.performance_metrics %}
        <table>
            <thead><tr><th>Metric</th><th>Current</th><th>Delta vs Baseline</th></tr></thead>
            <tbody>
            {% for name, val in monitoring.performance_metrics.items() %}
            <tr>
                <td>{{ name }}</td>
                <td>{{ "%.4f"|format(val) }}</td>
                <td>{% if monitoring.performance_delta and name in monitoring.performance_delta %}{{ "%.4f"|format(monitoring.performance_delta[name]) }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        {% if monitoring.data_quality %}
        <br>
        <div class="stat-grid">
            <div class="stat-card"><div class="value">{{ monitoring.data_quality.row_count | int }}</div><div class="label">Row Count</div></div>
            <div class="stat-card"><div class="value">{{ "%.2f"|format(monitoring.data_quality.missing_pct) }}%</div><div class="label">Missing</div></div>
            <div class="stat-card"><div class="value">{{ "%.2f"|format(monitoring.data_quality.duplicate_pct) }}%</div><div class="label">Duplicates</div></div>
        </div>
        {% endif %}
    </section>
    {% endif %}

    <footer>
        <p>Generated by <strong>Mentis</strong> · {{ generated_at }}</p>
    </footer>
</body>
</html>
