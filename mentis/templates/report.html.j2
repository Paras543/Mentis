<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mentis Report</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            background: #ffffff;
            color: #111111;
            line-height: 1.6;
            padding: 3rem 2rem;
            max-width: 1000px;
            margin: 0 auto;
        }
        header {
            border-bottom: 2px solid #000000;
            padding-bottom: 1.5rem;
            margin-bottom: 3rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }
        header h1 {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #000000;
            text-transform: uppercase;
        }
        .generated-at { color: #555555; font-size: 0.85rem; font-family: monospace; }

        section {
            border: 1px solid #000000;
            padding: 1.75rem;
            margin-bottom: 2.5rem;
            background: #ffffff;
        }
        section h2 {
            font-size: 1.15rem;
            font-weight: 800;
            color: #000000;
            margin-bottom: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 0.75rem;
        }
        .score-badge {
            display: inline-block;
            padding: 0.25rem 0.6rem;
            border: 1px solid #000000;
            font-size: 0.8rem;
            font-weight: 700;
            font-family: monospace;
            background: #000000;
            color: #ffffff;
        }

        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 0.5rem; }
        th {
            text-align: left;
            padding: 0.65rem 0.85rem;
            background: #f4f4f4;
            color: #000000;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            border-bottom: 1px solid #000000;
        }
        td { padding: 0.65rem 0.85rem; border-bottom: 1px solid #e0e0e0; color: #222222; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafafa; }

        .badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            font-family: monospace;
            border: 1px solid #000000;
        }
        .badge-critical { background: #000000; color: #ffffff; }
        .badge-warning  { background: #555555; color: #ffffff; }
        .badge-info     { background: #ffffff; color: #000000; }
        .badge-passed   { background: #ffffff; color: #000000; border-color: #000000; }
        .badge-failed   { background: #000000; color: #ffffff; }
        .badge-drift    { background: #000000; color: #ffffff; }
        .badge-ok       { background: #ffffff; color: #000000; }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .stat-card {
            border: 1px solid #000000;
            padding: 1rem;
            text-align: center;
            background: #ffffff;
        }
        .stat-card .value { font-size: 1.5rem; font-weight: 800; color: #000000; font-family: monospace; }
        .stat-card .label { font-size: 0.7rem; color: #555555; margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; }

        pre {
            background: #f9f9f9;
            border: 1px solid #cccccc;
            padding: 1rem;
            font-size: 0.8rem;
            font-family: monospace;
            overflow-x: auto;
            color: #111111;
            white-space: pre-wrap;
            word-break: break-all;
        }
        code { font-family: monospace; background: #f0f0f0; padding: 0.1rem 0.4rem; border: 1px solid #e0e0e0; }
        footer {
            text-align: center;
            color: #666666;
            font-size: 0.8rem;
            margin-top: 4rem;
            padding-top: 1.5rem;
            border-top: 1px solid #000000;
            font-family: monospace;
        }
        .empty-state { color: #666666; font-style: italic; text-align: center; padding: 1.5rem; font-size: 0.85rem; }
        .degraded-alert {
            border: 1px solid #000000;
            background: #000000;
            color: #ffffff;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .healthy-alert {
            border: 1px solid #000000;
            background: #ffffff;
            color: #000000;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
    </style>
</head>
<body>
    <header>
        <div>
            <h1>Mentis Report</h1>
        </div>
        <p class="generated-at">GENERATED: {{ generated_at }}</p>
    </header>

    {# ── Dataset Scan ─────────────────────────────────────────── #}
    {% if scan %}
    <section>
        <h2>Dataset Scan</h2>
        <div class="stat-grid">
            <div class="stat-card"><div class="value">{{ scan.n_rows | default('—') }}</div><div class="label">Rows</div></div>
            <div class="stat-card"><div class="value">{{ scan.n_columns | default('—') }}</div><div class="label">Columns</div></div>
            <div class="stat-card"><div class="value">{{ scan.summary.severity_counts.critical | default(0) }}</div><div class="label">Critical</div></div>
            <div class="stat-card"><div class="value">{{ scan.summary.severity_counts.warning | default(0) }}</div><div class="label">Warnings</div></div>
            <div class="stat-card"><div class="value">{{ "%.2f"|format(scan.memory_usage_mb | default(0)) }} MB</div><div class="label">Memory</div></div>
        </div>
        {% if scan.findings %}
        <table>
            <thead><tr><th>Check</th><th>Severity</th><th>Message</th><th>Suggestion</th></tr></thead>
            <tbody>
            {% for f in scan.findings %}
            <tr>
                <td><strong>{{ f.check_name }}</strong></td>
                <td><span class="badge badge-{{ f.severity }}">{{ f.severity }}</span></td>
                <td>{{ f.message }}</td>
                <td>{{ f.suggestion | default('—') }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No findings recorded. Dataset is clean.</p>
        {% endif %}
    </section>
    {% endif %}

    {# ── Model Comparison ─────────────────────────────────────── #}
    {% if comparison %}
    <section>
        <h2>Model Comparison</h2>
        {% if comparison.results %}
        <table>
            <thead>
                <tr>
                    <th>Rank</th>
                    <th>Model</th>
                    {% for key in comparison.results[0].metrics.keys() %}<th>{{ key }}</th>{% endfor %}
                    <th>CV Mean</th>
                    <th>CV Std</th>
                    <th>Train Time (s)</th>
                </tr>
            </thead>
            <tbody>
            {% for r in comparison.results %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><strong>{{ r.model_name }}</strong></td>
                {% for v in r.metrics.values() %}<td>{{ "%.4f"|format(v) }}</td>{% endfor %}
                <td>{{ "%.4f"|format(r.cv_mean) }}</td>
                <td>± {{ "%.4f"|format(r.cv_std) }}</td>
                <td>{{ "%.3f"|format(r.training_time_seconds) }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p class="empty-state">No model comparison results available.</p>
        {% endif %}
    </section>
    {% endif %}

    {# ── Explainability ───────────────────────────────────────── #}
    {% if explain %}
    <section>
        <h2>Explainability</h2>
        {% if explain.shap %}
        <p style="margin-bottom:1rem;"><strong>SHAP:</strong> Explainer type = <code>{{ explain.shap.explainer_type }}</code> | Base value = <code>{{ "%.4f"|format(explain.shap.base_value) }}</code></p>
        {% endif %}
        {% if explain.permutation_importance %}
        <p style="font-weight:700; margin-bottom:0.5rem; text-transform:uppercase; font-size:0.8rem;">Permutation Feature Importance</p>
        <table>
            <thead><tr><th>Feature</th><th>Importance Mean</th></tr></thead>
            <tbody>
            {% for feat, imp in explain.permutation_importance.items() %}
            <tr>
                <td><strong>{{ feat }}</strong></td>
                <td>{% if imp is mapping %}{{ "%.6f"|format(imp.importance_mean) }}{% else %}{{ "%.6f"|format(imp) }}{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        {% if explain.confusion_matrix %}
        <br><p style="font-weight:700; margin-bottom:0.5rem; text-transform:uppercase; font-size:0.8rem;">Confusion Matrix</p>
        <pre>{{ explain.confusion_matrix }}</pre>
        {% endif %}
    </section>
    {% endif %}

    {# ── Pipeline Audit ───────────────────────────────────────── #}
    {% if audit %}
    <section>
        {% set score = audit.score | float %}
        <h2>Pipeline Audit <span class="score-badge">SCORE: {{ score }}/100</span></h2>
        <table>
            <thead><tr><th>Check</th><th>Status</th><th>Severity</th><th>Suggestion</th></tr></thead>
            <tbody>
            {% for f in audit.findings %}
            <tr>
                <td><strong>{{ f.name }}</strong></td>
                <td><span class="badge {{ 'badge-passed' if f.passed else 'badge-failed' }}">{{ 'PASSED' if f.passed else 'FAILED' }}</span></td>
                <td>{% if not f.passed %}<span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>{% else %}—{% endif %}</td>
                <td>{% if not f.passed %}{{ f.suggestion }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
    {% endif %}

    {# ── Deployment Readiness ─────────────────────────────────── #}
    {% if deployment %}
    <section>
        {% set score = deployment.score | float %}
        <h2>Deployment Readiness <span class="score-badge">SCORE: {{ score }}/100</span></h2>
        {% if deployment.detected_framework %}
        <p style="margin-bottom:1rem; font-size:0.85rem;">Framework Detected: <code>{{ deployment.detected_framework }}</code></p>
        {% endif %}
        <table>
            <thead><tr><th>Check</th><th>Status</th><th>Severity</th><th>Suggestion</th></tr></thead>
            <tbody>
            {% for f in deployment.findings %}
            <tr>
                <td><strong>{{ f.name }}</strong></td>
                <td><span class="badge {{ 'badge-passed' if f.passed else 'badge-failed' }}">{{ 'PASSED' if f.passed else 'FAILED' }}</span></td>
                <td>{% if not f.passed %}<span class="badge badge-{{ f.severity }}">{{ f.severity }}</span>{% else %}—{% endif %}</td>
                <td>{% if not f.passed %}{{ f.suggestion }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
    {% endif %}

    {# ── Bias / Fairness ──────────────────────────────────────── #}
    {% if bias %}
    <section>
        <h2>Bias / Fairness Audit</h2>
        <table>
            <thead><tr><th>Sensitive Feature</th><th>Demo. Parity Diff</th><th>Equal Opp. Diff</th><th>Equalized Odds Diff</th></tr></thead>
            <tbody>
            {% for b in bias %}
            <tr>
                <td><strong>{{ b.sensitive_feature }}</strong></td>
                <td>{{ "%.4f"|format(b.demographic_parity_difference) }}</td>
                <td>{{ "%.4f"|format(b.equal_opportunity_difference) }}</td>
                <td>{{ "%.4f"|format(b.equalized_odds_difference) }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </section>
    {% endif %}

    {# ── Data Drift ───────────────────────────────────────────── #}
    {% if drift %}
    <section>
        <h2>Data Drift Detection</h2>
        <div class="stat-grid">
            <div class="stat-card">
                <div class="value">{{ 'YES' if drift.dataset_drift else 'NO' }}</div>
                <div class="label">Dataset Drift</div>
            </div>
            <div class="stat-card">
                <div class="value">{{ "%.1f"|format((drift.drift_share | default(0)) * 100) }}%</div>
                <div class="label">Drift Share</div>
            </div>
        </div>
        {% if drift.feature_drift %}
        <table>
            <thead><tr><th>Feature</th><th>Status</th><th>Drift Score</th><th>Stat Test</th></tr></thead>
            <tbody>
            {% for col, info in drift.feature_drift.items() %}
            <tr>
                <td><strong>{{ col }}</strong></td>
                <td><span class="badge {{ 'badge-drift' if info.drift_detected else 'badge-ok' }}">{{ 'DRIFT' if info.drift_detected else 'OK' }}</span></td>
                <td>{{ "%.4f"|format(info.drift_score) }}</td>
                <td>{{ info.stattest_name | default('—') }}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </section>
    {% endif %}

    {# ── Monitoring ───────────────────────────────────────────── #}
    {% if monitoring %}
    <section>
        <h2>Monitoring Snapshot</h2>
        {% if monitoring.degraded %}
        <div class="degraded-alert">ALERT: Model performance degradation detected. One or more metrics dropped beyond tolerance.</div>
        {% else %}
        <div class="healthy-alert">STATUS: Model performance is stable. No degradation detected.</div>
        {% endif %}
        {% if monitoring.performance_metrics %}
        <table>
            <thead><tr><th>Metric</th><th>Current</th><th>Delta vs Baseline</th></tr></thead>
            <tbody>
            {% for name, val in monitoring.performance_metrics.items() %}
            <tr>
                <td><strong>{{ name }}</strong></td>
                <td>{{ "%.4f"|format(val) }}</td>
                <td>{% if monitoring.performance_delta and name in monitoring.performance_delta %}{{ "%.4f"|format(monitoring.performance_delta[name]) }}{% else %}—{% endif %}</td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
        {% endif %}
        {% if monitoring.data_quality %}
        <br>
        <div class="stat-grid">
            <div class="stat-card"><div class="value">{{ monitoring.data_quality.row_count | int }}</div><div class="label">Row Count</div></div>
            <div class="stat-card"><div class="value">{{ "%.2f"|format(monitoring.data_quality.missing_pct) }}%</div><div class="label">Missing %</div></div>
            <div class="stat-card"><div class="value">{{ "%.2f"|format(monitoring.data_quality.duplicate_pct) }}%</div><div class="label">Duplicates %</div></div>
        </div>
        {% endif %}
    </section>
    {% endif %}

    <footer>
        <p>GENERATED BY MENTIS · {{ generated_at }}</p>
    </footer>
</body>
</html>
